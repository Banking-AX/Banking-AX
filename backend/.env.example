APP_DB_URL=jdbc:mysql://localhost:3306/banking_ax?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
APP_DB_USERNAME=banking_ax
APP_DB_PASSWORD=change-me
APP_AUTH_ENABLED=false
# Required when APP_AUTH_ENABLED=true. Use a random value of at least 32 UTF-8 bytes; never commit the real value.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_ISSUER=banking-ax
APP_JWT_ACCESS_TOKEN_MINUTES=30
APP_REFRESH_TOKEN_HOURS=24
# false for local HTTP only; set true in HTTPS deployments.
APP_AUTH_COOKIE_SECURE=false
APP_A02_LOAN_QUERY_PORT=fake
# Local private storage for synthetic B-01 application fixtures; do not use a public directory.
APP_B01_FILE_STORAGE_ROOT=./var/b01-documents
APP_B01_MAX_FILE_BYTES=10485760
APP_B01_SIGNATURE_STORAGE_ROOT=./var/b01-signatures
APP_B01_SIGNATURE_MAX_BYTES=1048576
# B-01 OCR defaults to the reviewed SHA-256 fixture. Set clova only in an approved server environment.
APP_B01_OCR_PROVIDER=mock
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
CLOVA_OCR_TEMPLATE_ID=
# C-02 uses the same approved CLOVA domain/secret but its own Template OCR ID.
APP_C02_OCR_PROVIDER=mock
# Template OCR ID must be verified from the response's matchedTemplate.id before production use.
APP_C02_CLOVA_TEMPLATE_ID=43868
CLOVA_OCR_CONNECT_TIMEOUT_SECONDS=3
CLOVA_OCR_READ_TIMEOUT_SECONDS=15
APP_TOOL_GATEWAY_TOKEN=replace-with-internal-token
# Server-to-server authentication for Spring BFF -> FastAPI customer Agent.
APP_CUSTOMER_AGENT_BASE_URL=http://localhost:8000
APP_CUSTOMER_AGENT_GATEWAY_TOKEN=replace-with-separate-customer-agent-token
APP_CUSTOMER_AGENT_TIMEOUT_SECONDS=20
APP_B01_IMAGE_ANALYSIS_ENABLED=false
APP_B01_IMAGE_ANALYSIS_TIMEOUT_SECONDS=10
APP_SMS_PROVIDER=mock
APP_OTP_TTL_SECONDS=180
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_SECONDS=60
APP_OTP_MAX_REQUESTS=5
# Use at least 32 random bytes. Never reuse the JWT secret or commit the real value.
APP_OTP_HMAC_SECRET=replace-with-separate-random-secret-at-least-32-bytes
# Required only for APP_SMS_PROVIDER=solapi. Keep real values outside Git.
SOLAPI_API_ENDPOINT=https://api.solapi.com/messages/v4/send-many/detail
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# Bank change feed. The Mock is served by the AI server; use the same two secrets in ai-server/.env.
APP_POLICY_CHANGE_PROVIDER=mock-bank
APP_POLICY_SOURCE_BASE_URL=http://127.0.0.1:9001
POLICY_SOURCE_TOKEN=
POLICY_SOURCE_SIGNING_SECRET=
